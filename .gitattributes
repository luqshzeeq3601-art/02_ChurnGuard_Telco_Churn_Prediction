# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.parquet binary
*.joblib binary
